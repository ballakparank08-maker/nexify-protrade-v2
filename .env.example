# Frontend API base URL (Live Render Backend URL)
VITE_API_BASE_URL="https://nexify-protrade-v2-1.onrender.com/api"

# Vite dev proxy target
VITE_PROXY_TARGET="http://localhost:3001"

# Backend Configuration
PORT="3001"
DATABASE_PATH="./server/data/nexify-protrade.json"
AUTH_SECRET="nexify-protrade-production-auth-secret-key-9988"
FRONTEND_ORIGIN="https://nexifyprotrade.site,https://www.nexifyprotrade.site,https://nexifyprotrade.com,https://www.nexifyprotrade.com,http://localhost:3000"
SESSION_TTL_HOURS="168"
AUTH_COOKIE_NAME="nexify_session"
AUTH_COOKIE_SECURE="true"
AUTH_COOKIE_SAME_SITE="none"

# Optional one-time admin bootstrap values used by npm run bootstrap:admin
ADMIN_BOOTSTRAP_NAME="Initial Admin"
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMe123!"
