# Frontend
# Leave unset in local development to use the Vite /api proxy.
# Set this in production (for example on GitHub Pages) to the separately hosted backend origin.
VITE_API_BASE_URL="https://your-backend.example.com/api"

# Vite dev proxy target
VITE_PROXY_TARGET="http://localhost:3001"

# Backend
PORT="3001"
DATABASE_PATH="./server/data/nexify-protrade.sqlite"
AUTH_SECRET="replace-with-a-long-random-secret"
FRONTEND_ORIGIN="http://localhost:3000"
SESSION_TTL_HOURS="168"
AUTH_COOKIE_NAME="nexify_session"
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_SAME_SITE="lax"

# Optional one-time admin bootstrap values used by npm run bootstrap:admin
ADMIN_BOOTSTRAP_NAME="Initial Admin"
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"
ADMIN_BOOTSTRAP_PASSWORD="ChangeMe123!"
